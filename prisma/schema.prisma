generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserLanguage {
  es
  en
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
}

enum BillCategory {
  UTILITIES
  HOUSING
  INSURANCE
  SUBSCRIPTION
  DEBT
}

enum BillFrequency {
  MONTHLY
  BIWEEKLY
  YEARLY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  squareCustomerId     String?              @unique
  squareSubscriptionId String?              @unique
  subscriptionStatus   SubscriptionStatus   @default(INACTIVE)
  subscriptionPrice    Decimal              @default(19.99) @db.Decimal(10, 2)

  language UserLanguage @default(en)
  timezone String   @default("America/New_York")
  currency String   @default("USD")

  accounts          Account[]
  recurringBills    RecurringBill[]
  dailyBriefingLogs DailyBriefingLog[]

  @@index([email])
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  type           AccountType
  currentBalance Decimal     @db.Decimal(12, 2)
  creditLimit    Decimal?    @db.Decimal(12, 2)
  closingDay     Int?
  dueDay         Int?
  apr            Decimal?    @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RecurringBill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  category  BillCategory
  amount    Decimal        @db.Decimal(12, 2)
  dueDay    Int
  dueDate   DateTime?
  frequency BillFrequency  @default(MONTHLY)
  isPaid    Boolean        @default(false)
  autoPay   Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, dueDay])
}

model DailyBriefingLog {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 DateTime @db.Date
  generatedSummaryText String
  audioUrl             String?
  alertCount           Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}
