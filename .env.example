# Copy to `.env.local` in the project root (not src/app). Restart `next dev`.
# Next.js loads NEXT_PUBLIC_* only at process start — stop the old `npm run dev`
# after changing keys, or it will keep serving a stale anon JWT.
# Next.js loads .env files only from the project root, never from /src.
# Prisma CLI also reads DATABASE_URL from a root `.env`.

# PostgreSQL for Mi Centro Financiero (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mi_centro_financiero?schema=public"
# Optional: load a real User id on /centro instead of sample data
NEXT_PUBLIC_FINANCE_USER_ID=

# Supabase public credentials (read by src/lib/supabase-config.ts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — required for /api/webhooks/subscriptions and /api/housekeeping/upload
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for POST /api/webhooks/subscriptions. Server-only; route fails closed when empty.
# Send as x-webhook-secret or Authorization: Bearer <secret>.
SUBSCRIPTION_WEBHOOK_SECRET=

# Elena AI: voice (/api/tts) and generated replies (/api/avatar).
# Prefer ElevenLabs for hyper-realistic speech. OpenAI gpt-audio is the fallback.
ELEVENLABS_API_KEY=
# Optional: override the default Elena ElevenLabs voice id (Rachel).
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=sk-your-openai-key
# Optional: OpenAI Admin API key for organization Usage/Costs reconciliation (server-only).
# Never expose to the browser. Leave unset if you do not have an Admin key.
# OPENAI_ADMIN_KEY=
# Optional: when set, /api/avatar prefers Claude and falls back to OpenAI.
ANTHROPIC_API_KEY=
# Server-only Google Places Nearby Search for Voice Concierge (never NEXT_PUBLIC).
GOOGLE_PLACES_API_KEY=

# Optional public origin for production QR codes and guest links (HTTPS tunnel or domain).
# Leave empty for local HTTP. For phone Tap to talk, keep npm run dev running and run
# `npm run tunnel` in a second terminal (free Cloudflare / localtunnel HTTPS URL).
# Example: https://app.yourdomain.com
NEXT_PUBLIC_BASE_URL=
# Optional aliases (used only if NEXT_PUBLIC_BASE_URL is empty).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SECURE_ORIGIN=
PUBLIC_APP_URL=

# Square checkout (/api/checkout and /api/payments/square/checkout)
# Required: explicitly set to sandbox or production. Missing/other values fail closed.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=your-square-app-id
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
# Square Subscription Plan Variation IDs. Configure all eight for the active
# environment. Sandbox never falls back to Production, or Production to Sandbox.
SQUARE_SANDBOX_PLAN_VARIATION_STARTER_MONTHLY=your-square-sandbox-starter-monthly-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_STARTER_ANNUAL=your-square-sandbox-starter-annual-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_PRO_MONTHLY=your-square-sandbox-pro-monthly-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_PRO_ANNUAL=your-square-sandbox-pro-annual-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_PORTFOLIO_MONTHLY=your-square-sandbox-portfolio-monthly-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_PORTFOLIO_ANNUAL=your-square-sandbox-portfolio-annual-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_AGENCY_MONTHLY=your-square-sandbox-agency-monthly-plan-variation-id
SQUARE_SANDBOX_PLAN_VARIATION_AGENCY_ANNUAL=your-square-sandbox-agency-annual-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_STARTER_MONTHLY=your-square-production-starter-monthly-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_STARTER_ANNUAL=your-square-production-starter-annual-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_PRO_MONTHLY=your-square-production-pro-monthly-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_PRO_ANNUAL=your-square-production-pro-annual-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_PORTFOLIO_MONTHLY=your-square-production-portfolio-monthly-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_PORTFOLIO_ANNUAL=your-square-production-portfolio-annual-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_AGENCY_MONTHLY=your-square-production-agency-monthly-plan-variation-id
SQUARE_PRODUCTION_PLAN_VARIATION_AGENCY_ANNUAL=your-square-production-agency-annual-plan-variation-id
# Optional: force local mock checkout (skips live Square Payment Links)
SQUARE_MOCK_CHECKOUT=
# Required for POST /api/webhooks/square. Server-only; never expose either value.
# Copy the signature key and exact HTTPS notification URL from the Square Developer Console.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Superadmin emails for /admin/revenue (comma-separated). Or set user_metadata.role = superadmin.
ADMIN_EMAILS=

# Founder System Health Alerts V1 (comma-separated). Do not reuse ADMIN_EMAILS.
# If empty, alert delivery is reported as unconfigured (no silent fallback).
FOUNDER_ALERT_EMAILS=
# From address for Founder alerts (Resend). Domain must be verified.
FOUNDER_ALERT_FROM=Zencierge Alerts <alerts@zencierge.app>
# Shared secret for GET/POST /api/cron/system-health-alerts.
# Local/manual: send header x-cron-secret or Authorization: Bearer <value>.
# Future Vercel Cron (OFF now): set the same CRON_SECRET in the Vercel project env;
# Vercel injects Authorization: Bearer <CRON_SECRET> on scheduled GETs.
# Activation steps: deploy/ALERTS_V1B_SCHEDULER.md (do not add vercel.json crons until then).
CRON_SECRET=

# Optional: email the host when housekeeping sends a photo report (Resend).
HOST_NOTIFY_EMAIL=
RESEND_API_KEY=
HOST_NOTIFY_FROM=
